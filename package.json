{
  "name": "dsh-plugin-session-cleaner",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Manual, exact-ID deletion of saved sessions for DeepSeek Harness.",
  "license": "MIT",
  "keywords": ["dsh-plugin"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
